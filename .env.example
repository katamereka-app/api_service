PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=katamereka_db
NODE_ENV=development
# Required in production (server refuses to start without it). Generate your
# own, e.g. `openssl rand -hex 32` — never reuse the value below.
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=7d
GEOAPIFY_API_KEY=your_geoapify_api_key
# Public consumer site URL — used to build the sitemap.xml URL pinged to
# Google whenever a business is created/updated. Defaults to
# https://katamereka.id if unset.
CONSUMER_SITE_URL=https://katamereka.id
